                  "pm.test(\"AGUARDANDO_PAGAMENTO\",()=>pm.expect(j.status===\"AGUARDANDO_PAGAMENTO\").to.be.true);",
                  "pm.test(\"canal TOTEM\",()=>pm.expect(j.canal_pedido===\"TOTEM\").to.be.true);",
